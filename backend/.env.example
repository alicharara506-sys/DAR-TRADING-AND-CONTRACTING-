# Database
DATABASE_URL="postgresql://dar:dar_secure_password@localhost:5432/dar_erp?schema=public"

# Application
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters!
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# AI Assistant (optional — enables LLM-backed answers; rule engine works without it)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DAR ERP <noreply@dar-tc.com>"
